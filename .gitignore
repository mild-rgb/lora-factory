# Whitelist: only code, write-ups and small result tables go to GitHub.
/*
!/README.md
!/RESULTS.md
!/.gitignore
!/scripts/
/scripts/__pycache__/
!/factory/
/factory/*
!/factory/per_lora_rates.csv
!/factory/jobs.json
!/factory/jobs_smoke.json
!/factory_cross/
/factory_cross/*
!/factory_cross/jobs_cross.json
!/factory_cross/run_cross.sh
!/factory_cross/cross_results.json
!/factory_cross/per_lora_rates_cross.csv
!/weights/
/weights/*
!/weights/features.csv
!/weights/features_corr_old_germany_rate.csv
!/weights/summary.json
!/activations/
/activations/*
!/activations/RESULTS_activations.md
!/activations/analysis_log.txt
!/activations/robustness_log.txt
!/activations/per_lora_acts.csv
!/wg_more/
/wg_more/*
!/wg_more/jobs_*.json
!/wg_more/questions_*.json
!/wg_more/judge_*.txt
!/wg_more/run_wg.sh
!/wg_more/chain.sh
!/wg_more/push.py
!/wg_more/results*.json
!/wg_more/per_lora_rates_*.csv
